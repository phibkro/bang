data Box = BLeft(Int) | BRight(Int)

trait Eq { fn eq(a, b) -> (Unit + Unit) law refl(a): a == a }

impl Eq for Box {
  fn eq(p, q) = match p {
    BLeft(x) -> match q { BLeft(y) -> x == y, BRight(y) -> 0 == 1 },
    BRight(x) -> match q { BLeft(y) -> 0 == 1, BRight(y) -> x == y }
  }
}

let a = BLeft(3) in
let b = BLeft(3) in
let c = BRight(3) in
let same = a == b in
let diff = a == c in
if same then (if diff then 9 else 1) else 0
