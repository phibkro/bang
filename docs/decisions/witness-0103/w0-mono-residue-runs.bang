-- Observed 2026-07-11 on the real binary: `bang run` → 2 ; `bang check --json` → {"ok":true}.
data List a = Nil | Cons(a, List a)
let rec length : List Int -> Int =
  fun xs => match (xs : List Int) { Nil -> 0, Cons(h, t) -> 1 + (($length) t) }
$length (Cons(1, Cons(2, Nil)))
