{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bang-lang.org/web/docs/page-manifest.schema.json",
  "title": "BANG public documentation page manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "basePath",
    "sections",
    "publications",
    "pages"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "branch"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
        "branch": { "$ref": "#/$defs/nonempty" }
      }
    },
    "basePath": { "type": "string", "pattern": "^/[a-z0-9-]+$" },
    "sections": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/section" }
    },
    "publications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/exactPublication" },
          { "$ref": "#/$defs/treePublication" }
        ]
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "kebabCase": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "route": {
      "type": "string",
      "pattern": "^/(?:[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*)?$"
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["consumer", "contributor", "agent"] }
    },
    "lifecycle": { "enum": ["snapshot", "done", "next", "now"] },
    "status": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fact", "schema", "pointer"],
          "properties": {
            "kind": { "const": "evidence" },
            "fact": { "$ref": "#/$defs/repoPath" },
            "schema": { "$ref": "#/$defs/repoPath" },
            "pointer": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)+$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "not-applicable" },
            "reason": { "$ref": "#/$defs/kebabCase" }
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "order"],
      "properties": {
        "id": {
          "enum": ["start", "learn", "reference", "contribute", "architecture", "project"]
        },
        "title": { "$ref": "#/$defs/nonempty" },
        "order": { "type": "integer", "minimum": 0 },
        "collapsed": { "type": "boolean" }
      }
    },
    "metadataDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "lifecycle", "status"],
      "properties": {
        "audience": { "$ref": "#/$defs/audience" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "exactPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mode", "source", "route"],
      "properties": {
        "kind": { "const": "exact" },
        "mode": { "const": "managed" },
        "source": { "$ref": "#/$defs/repoPath" },
        "route": { "$ref": "#/$defs/route" }
      }
    },
    "treePublication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mode", "sourceRoot", "routePrefix", "defaults"],
      "properties": {
        "kind": { "const": "tree" },
        "mode": { "enum": ["managed", "catalog"] },
        "sourceRoot": { "$ref": "#/$defs/repoPath" },
        "routePrefix": { "$ref": "#/$defs/route" },
        "defaults": { "$ref": "#/$defs/metadataDefaults" }
      }
    },
    "localTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "route"],
          "properties": {
            "kind": { "const": "markdown" },
            "path": { "$ref": "#/$defs/repoPath" },
            "route": { "$ref": "#/$defs/route" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "route"],
          "properties": {
            "kind": { "const": "tour-index" },
            "route": { "$ref": "#/$defs/route" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "route", "contentKey"],
          "properties": {
            "kind": { "const": "tour-lesson" },
            "route": { "$ref": "#/$defs/route" },
            "contentKey": { "$ref": "#/$defs/kebabCase" }
          }
        }
      ]
    },
    "repositoryTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "view"],
      "properties": {
        "kind": { "const": "repository-link" },
        "path": { "$ref": "#/$defs/repoPath" },
        "view": { "enum": ["blob", "tree"] }
      }
    },
    "navigation": {
      "oneOf": [
        { "const": false },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["order"],
          "properties": {
            "order": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "section",
        "audience",
        "lifecycle",
        "prerequisites",
        "status",
        "target",
        "navigation"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/kebabCase" },
        "title": { "$ref": "#/$defs/nonempty" },
        "section": {
          "enum": ["start", "learn", "reference", "contribute", "architecture", "project"]
        },
        "audience": { "$ref": "#/$defs/audience" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/kebabCase" }
        },
        "status": { "$ref": "#/$defs/status" },
        "target": {
          "oneOf": [
            { "$ref": "#/$defs/localTarget" },
            { "$ref": "#/$defs/repositoryTarget" }
          ]
        },
        "navigation": { "$ref": "#/$defs/navigation" }
      }
    }
  }
}
