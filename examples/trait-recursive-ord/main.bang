-- Uses the type-qualified `IntList_Nil`/`IntList_Cons` spelling (ADR-0099): the prelude's
-- unconditional `data List a = Nil | Cons(a, List a)` (ADR-0103 Amendment ①) shares these bare
-- ctor names, so a bare reference here would be ambiguous (B012).
data IntList = Nil | Cons(Int, IntList)

trait Ord { fn lt(a, b) -> (Unit + Unit) law irrefl(a): 0 == 0 }

impl Ord for IntList {
  fn lt(p, q) = match p {
    IntList_Nil -> match q { IntList_Nil -> 0 == 1, IntList_Cons(hy, ty) -> 0 == 0 },
    IntList_Cons(hx, tx) -> match q {
      IntList_Nil -> 0 == 1,
      IntList_Cons(hy, ty) -> if hx < hy then 0 == 0 else (if hy < hx then 0 == 1 else tx < ty)
    }
  }
}

let l1 = IntList_Cons(1, IntList_Cons(2, IntList_Nil)) in
let l2 = IntList_Cons(1, IntList_Cons(3, IntList_Nil)) in
let l3 = IntList_Cons(1, IntList_Cons(2, IntList_Nil)) in
let less = l1 < l2 in
let notLess = l2 < l3 in
if less then (if notLess then 9 else 1) else 0
