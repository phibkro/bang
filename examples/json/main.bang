import Json
import Parse
import Print
let tagOf = {fun j =>
    match (j : Json_Json) {
      JNull -> 0,
      JBool(x) -> 1,
      JInt(x) -> 2,
      JStr(x) -> 3,
      JArr(x) -> 4,
      JObj(x) -> 5,
      JCons(x, y) -> 6,
      JNilL -> 7,
      JField(x, y) -> 8
    }}
let rec tagAt : Int -> Json_Json -> Int ! {Div} = fun idx =>
    fun j =>
      match (j : Json_Json) {
        JNull -> 0 - 1,
        JBool(x) -> 0 - 1,
        JInt(x) -> 0 - 1,
        JStr(x) -> 0 - 1,
        JArr(l) -> ($tagAt) idx l,
        JObj(x) -> 0 - 1,
        JCons(h, t) -> if idx == 0 then ($tagOf) h else ($tagAt) (idx - 1) t,
        JNilL -> 0 - 1,
        JField(x, y) -> 0 - 1
      }
let boolToBit = {fun r => match r { Left(u) -> 0, Right(u) -> 1 }}
let main =
  let arrJ = $(Parse.parseTop) "[1, 2, 3]"
    in
  let arrTag0 = ($tagAt) 0 arrJ
    in
  let objJ = $(Parse.parseTop) "{\"a\": 1, \"b\": 2}"
    in
  let objTag = ($tagOf) objJ
    in
  let nestedJ = $(Parse.parseTop) "[10, [20, 30], {\"x\": true, \"y\": null}]"
    in
  let nestedTag0 = ($tagAt) 0 nestedJ
    in
  let nestedTag1 = ($tagAt) 1 nestedJ
    in
  let nestedTag2 = ($tagAt) 2 nestedJ
    in
  let sampleArr = {Json_JArr (Json_JCons(Json_JInt 1, Json_JCons(Json_JInt 2, Json_JCons(Json_JInt 3, Json_JNilL))))}
    in
  let printedArr = $(Print.printJson) $sampleArr
    in
  let printedArrOk = $eq printedArr "[1,2,3]"
    in
  arrTag0 * 1 + objTag * 10 + nestedTag0 * 1 + nestedTag1 * 1 + nestedTag2 * 1 +
  ($boolToBit) printedArrOk * 100
