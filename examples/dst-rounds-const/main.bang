-- MINI-DST rounds, CONST scheduler — the swap partner of ../dst-rounds-lcg/.
-- The SAME recursive driver (byte-identical body), with only the Sched
-- policy swapped: every delivery draw returns 0, so the two replicas
-- always agree on delivery order and EVERY round converges (16/16).
-- Contrast with the LCG policy, where 9/16 rounds converge.

effect Sched { bit : Int -> Int }

-- LCG step: s' = (s * 25 + 17) mod 65536, spelled with s - (s/k)*k.
let rec step : Int -> Int ! {Div} = fun s =>
  let t = s * 25 + 17 in t - (t / 65536) * 65536

let main =
  handle
    let rec go : Int -> Int -> Int -> Int ! {Div, Sched} =
      fun n => fun s => fun acc =>
        if n == 0 then acc
        else
          let o1 = sched.bit(s) in
          let s1 = ($step) s in
          let o2 = sched.bit(s1) in
          let s2 = ($step) s1 in
          ($go) (n - 1) s2 (acc + (if o1 == o2 then 1 else 0))
    in ($go) 16 12345 0
  with Sched as sched {
    -- policy: constant delivery order — a fully synchronous network.
    bit(s) => 0
  }
