-- A tiny spreadsheet over BANG's existing reactive substrate and queryable formula graph.
--
-- Input cells are named State capabilities. The stable formula DAG lives in Formulas.bang:
--   subtotal = price * quantity
--   tax      = subtotal / 10
--   total    = subtotal + tax
--
-- The local `liveTotal` thunk is the observation boundary: it re-samples both State inputs, then
-- evaluates the static formula DAG. With price=10 and quantity=2, total is 22. After price becomes
-- 12, forcing it returns 26. `snapshot` deliberately captures the already-forced value 22, so it
-- stays 22: forcing at the formula boundary is BANG's explicit sample/untrack operation (ADR-0005).
use Formulas (total)

state 10 as price in
state 2 as quantity in
let liveTotal = {let p = price.get in let q = quantity.get in $total p q} in
let before = $liveTotal in
let sampled = $liveTotal in
let snapshot = {sampled} in
let updated = price.put(12) in
let liveAfter = $liveTotal in
let staleAfter = $snapshot in
((before, liveAfter), (sampled, staleAfter))
