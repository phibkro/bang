-- sched-swap-dfs — the HANDLER-SWAP partner of ../sched-roundrobin/: byte-identical
-- driver body, ONLY the Sched handler's `next` clause differs (constant `0` instead
-- of `round mod 3`) — depth-first / run-to-completion instead of round-robin. Task 1
-- runs all 3 of its steps before task 2 even starts (it is always the lowest-index
-- RUNNABLE task, so it wins `sched.next` every round until it finishes): 111222333.
--
-- This is the payoff demo (ADR-0101 §G1, "paradigm is a value; runtime is the
-- installed handler"): the driver never says HOW tasks interleave, only that they
-- take turns through `sched.next`. The SAME program, same task set, same `Sched`
-- effect row — one clause in the `with` block changed, and the entire concurrency
-- behavior changed with it. See ../../docs/notes/sched-library-demo.md
-- §"the handler-swap beat" for the diff-only comparison against ../sched-roundrobin/.
import Sched
import Task

handle
  (let tid1 = sched.spawn(1) in
   let tid2 = sched.spawn(2) in
   let tid3 = sched.spawn(3) in
   let t1 = ($(Task.makeTask)) tid1 3 in
   let t2 = ($(Task.makeTask)) tid2 3 in
   let t3 = ($(Task.makeTask)) tid3 3 in
   -- drive: pop-one-step-per-round over a fixed 3-slot queue (ta/sa, tb/sb, tc/sc =
   -- task-id/current-Step pairs). A finished slot (Fin) is skipped without consuming
   -- a `sched.next` pick — the handler is only asked to choose among RUNNABLE tasks,
   -- so the trace never "wastes" a round on a task that has nothing left to do.
   let rec drive
     : Int -> Step -> Int -> Step -> Int -> Step -> Int -> Int -> Int ! {Div, Sched_Sched}
     = fun ta => fun sa => fun tb => fun sb => fun tc => fun sc => fun round => fun acc =>
       match (sa : Step) {
         Fin(u) -> match (sb : Step) {
           Fin(v) -> match (sc : Step) {
             Fin(w) -> acc,
             More(kc) -> (let c1 = ($kc) () in
                          let acc1 = acc * 10 + tc in
                          ($drive) ta sa tb sb tc c1 (round + 1) acc1)
           },
           More(kb) -> (let b1 = ($kb) () in
                        let acc1 = acc * 10 + tb in
                        ($drive) ta sa tb b1 tc sc (round + 1) acc1)
         },
         More(ka) -> match (sb : Step) {
           Fin(v) -> match (sc : Step) {
             Fin(w) -> (let a1 = ($ka) () in
                        let acc1 = acc * 10 + ta in
                        ($drive) ta a1 tb sb tc sc (round + 1) acc1),
             More(kc) ->
               (let choice = sched.next(round) in
                if choice == 0 then
                  (let a1 = ($ka) () in
                   let acc1 = acc * 10 + ta in
                   ($drive) ta a1 tb sb tc sc (round + 1) acc1)
                else
                  (let c1 = ($kc) () in
                   let acc1 = acc * 10 + tc in
                   ($drive) ta sa tb sb tc c1 (round + 1) acc1))
           },
           More(kb) -> match (sc : Step) {
             Fin(w) ->
               (let choice = sched.next(round) in
                if choice == 0 then
                  (let a1 = ($ka) () in
                   let acc1 = acc * 10 + ta in
                   ($drive) ta a1 tb sb tc sc (round + 1) acc1)
                else
                  (let b1 = ($kb) () in
                   let acc1 = acc * 10 + tb in
                   ($drive) ta sa tb b1 tc sc (round + 1) acc1)),
             More(kc) ->
               (let choice = sched.next(round) in
                if choice == 0 then
                  (let a1 = ($ka) () in
                   let acc1 = acc * 10 + ta in
                   ($drive) ta a1 tb sb tc sc (round + 1) acc1)
                else (if choice == 1 then
                  (let b1 = ($kb) () in
                   let acc1 = acc * 10 + tb in
                   ($drive) ta sa tb b1 tc sc (round + 1) acc1)
                else
                  (let c1 = ($kc) () in
                   let acc1 = acc * 10 + tc in
                   ($drive) ta sa tb sb tc c1 (round + 1) acc1)))
           }
         }
       }
   in ($drive) tid1 t1 tid2 t2 tid3 t3 0 0)
with Sched_Sched as sched {
  spawn(n) => n,
  -- depth-first / run-to-completion: ALWAYS prefer the lowest-index runnable task
  -- (index 0 = task A), so task A's whole 3-step run happens before B ever gets a
  -- turn. The ONLY diff against ../sched-roundrobin/main.bang is this one clause.
  next(round) => 0
}
