{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bang-lang.org/docfacts/schema/example.schema.json",
  "title": "BANG example documentation fact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "title",
    "summary",
    "supportedEngines",
    "concepts",
    "program",
    "expectedOutput",
    "evidence",
    "relatedExamples"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "example" },
    "id": { "$ref": "common.schema.json#/$defs/kebabId" },
    "title": { "$ref": "common.schema.json#/$defs/nonemptyString" },
    "summary": { "$ref": "common.schema.json#/$defs/nonemptyString" },
    "supportedEngines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["env", "oracle", "compiled"] }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/kebabId" }
    },
    "refusalClass": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/kebabId" },
        { "type": "null" }
      ]
    },
    "program": { "$ref": "#/$defs/fileContent" },
    "expectedOutput": { "$ref": "#/$defs/fileContent" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/evidence" }
    },
    "relatedExamples": {
      "type": "array",
      "items": { "$ref": "#/$defs/relatedExample" }
    }
  },
  "$defs": {
    "fileContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "text"],
      "properties": {
        "path": { "$ref": "common.schema.json#/$defs/repoPath" },
        "text": { "type": "string" }
      }
    },
    "relatedExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/kebabId" },
        "path": { "$ref": "common.schema.json#/$defs/repoPath" }
      }
    }
  }
}
