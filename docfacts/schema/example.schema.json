{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bang-lang.org/docfacts/schema/example.schema.json",
  "title": "BANG example documentation fact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "title",
    "summary",
    "supportedEngines",
    "concepts",
    "program",
    "expectedOutput",
    "evidence",
    "relatedExamples"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "example" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "supportedEngines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["env", "oracle", "compiled"] }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/kebabCase" }
    },
    "refusalClass": {
      "anyOf": [
        { "$ref": "#/$defs/kebabCase" },
        { "type": "null" }
      ]
    },
    "program": { "$ref": "#/$defs/fileContent" },
    "expectedOutput": { "$ref": "#/$defs/fileContent" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "relatedExamples": {
      "type": "array",
      "items": { "$ref": "#/$defs/relatedExample" }
    }
  },
  "$defs": {
    "kebabCase": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "fileContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "text"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "text": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "claim", "sources", "commands"],
      "properties": {
        "label": {
          "enum": [
            "proven",
            "differential-tested",
            "generated",
            "implemented",
            "proposed"
          ]
        },
        "claim": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repoPath" },
          "uniqueItems": true
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "relatedExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "path": { "$ref": "#/$defs/repoPath" }
      }
    }
  }
}
