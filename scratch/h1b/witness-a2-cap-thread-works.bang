-- witness-a2 — the CONTRAST case: the pre-existing cap-threading spelling (con.print) DOES get
-- intercepted by the enclosing with, with zero --env plumbing. Demonstrates the "two spellings,
-- deliberately different constructs" claim (ADR-0104 §4) is real: swap Io.print for con.print
-- in witness-a-status-quo.bang and the SAME program becomes driver-independent.
import Io
let main =
  handle
    con.print(SCons(Char(104), SCons(Char(105), SNil)))   -- cap-threading spelling
  with Io_Console as con {
    print(s) => (),
    readLine(u) => SCons(Char(104), SNil)
  }
