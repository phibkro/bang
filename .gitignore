# Release artifacts (tools/release-artifact.sh stages the stripped binary here before upload)
dist/

# Lean / Lake build artifacts (Mathlib oleans etc. — multi-GB, fetched via `lake exe cache get`)
.lake/
*.olean
*.ilean
*.c.o

# Node / harness
node_modules/
.pnpm-store/

# Python (tools/ generators — bytecode cache re-dirties the tree each run)
__pycache__/
*.pyc

# F* / OCaml alternate oracle build
oracle/_build/
*.checked
*.cmi
*.cmo
*.cmx
*.o

# Tool invocation telemetry (tools/tool-log.sh appends here; per-machine data, not repo content — plan 012)
.claude/tool-invocations.log

# direnv
.direnv/

# macOS
.DS_Store

# generated dashboard (CI regenerates via .github/workflows/pages.yml)
_site/
# vocs docs site: commit sources only (package.json, vocs.config.ts, sync-docs.mjs, bun.lock);
# node_modules, build output, cache, and the generated page farm are derived
web/docs/node_modules/
web/docs/dist/
web/docs/.vocs/
web/docs/src/
web/docs/public/
docbuild/BangDocs.lean
