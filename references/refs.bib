@misc{kobayashi-kameyama-aplas25-oneshot-expressiveness,
  keywords = {topic:multishot role:frontier},
  author = {Kobayashi, Kentaro and Kameyama, Yukiyoshi},
  title  = {Expressive Power of One-Shot Control Operators and Coroutines},
  year   = 2025,
  doi    = {10.48550/arXiv.2509.11901},
  note   = {Full version of the APLAS 2025 paper. Rigorous Felleisen-macro-expressiveness comparison
             among ONE-SHOT control operators (one-shot effect handlers, one-shot delimited control,
             asymmetric coroutines). Key result for Q22: one-shot effect handlers + one-shot
             delimited control are macro-expressible BY asymmetric coroutines but NOT vice versa —
             a genuine expressiveness gap, so "one-shot + explicit copy" is NOT free syntactic sugar;
             recovering the ω patterns (amb/backtracking/generators) is a real, non-macro cost. The
             formal grounding for why bang's ω-channel (Q27), if it ships, is a genuinely distinct
             capability worth typing separately. Assessed in docs/notes/multishot-survey.md §1.
             \url{https://arxiv.org/abs/2509.11901}},
}

@inproceedings{biernacki-popl18-handle-with-care,
  keywords = {topic:lr topic:multishot grounds:inv-1 role:substrate},
  author    = {Biernacki, Dariusz and Pir\'{o}g, Maciej and Polesiuk, Piotr and Sieczkowski, Filip},
  title     = {Handle with Care: Relational Interpretation of Algebraic Effects and Handlers},
  booktitle = {Proceedings of the ACM on Programming Languages (POPL)},
  year      = 2018,
  doi       = {10.1145/3158096},
  note    = {The canonical step-indexed, biorthogonal (⊤⊤-closed) logical relation for a CBV
             calculus with algebraic-effect handlers + row-polymorphic effect types — the
             literature line bang's binary LR (◊4 contextual equivalence) descends from. Its
             handlers are FULL (multi-shot): the continuation-value relation quantifies over
             resumptions invoked ANY number of times, so the LR is closed under a captured
             continuation being re-entered — the resumption is a first-class related VALUE, not a
             one-use frame. The verification-tax datum for Q22: this is what a multi-shot LR
             already costs even WITHOUT bang's identity-dispatch reshape; going multi-shot means
             the continuation relation must survive re-entry (heap/store framing across each
             re-invoke), which one-shot's reinstall-inside-resumption sidesteps
             (cf. devilhena-pottier-popl21 §4.2.3 — the Löb/later-modality guard that only closes
             because the deep handler reinstalls INSIDE the resumption). Assessed in
             docs/notes/multishot-survey.md §verification-tax.},
}

