@misc{emrich-hillerstrom-continuing-stack-switching-wasmtime,
  keywords = {topic:wasmfx topic:multishot role:substrate},
  author = {Emrich, Frank and Hillerstr\"{o}m, Daniel},
  title  = {Continuing Stack Switching in Wasmtime},
  year   = 2025,
  note   = {WebAssembly Workshop 2025 talk. Reports the production Wasmtime implementation of the
             WasmFX stack-switching proposal (\url{https://wasmfx.dev}) — bang's OWN ◊6 backend
             target. THE backend constraint for Q22: WasmFX continuations are SINGLE-SHOT (aka
             linear) BY CONSTRUCTION — resume/resume_throw/cont.bind DESTRUCTIVELY consume the
             continuation object (any second use traps), which is exactly what lets the runtime use
             reference counting instead of a GC and avoid stack copying. Multi-shot is EXPLICITLY
             out of the current proposal ("none of the critical use cases require multi-shot") and
             is deferred to a hypothetical future `cont clone` instruction. So bang's backend
             natively supports one-shot at zero copy cost and offers NO cheap multi-shot primitive
             — the machine-design constraint the CalcReify probe must respect regardless of the
             kernel choice. Assessed in docs/notes/multishot-survey.md §wasmfx-constraint.},
  % venue: WebAssembly Workshop (WAW) 2025, co-located with PLDI'25.
}

