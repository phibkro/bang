#!/usr/bin/env bash
# tool: role=check couples=justfile,autoquality.sh,gen-changelog.py runs-in=hook
source "$(git rev-parse --show-toplevel 2>/dev/null)/tools/tool-log.sh" 2>/dev/null && tool_log "$(basename "$0")" || true
# pre-commit hook — invariants checked before each commit.
# Installation: bash tools/install-hooks.sh
#
# Fast static checks ALWAYS run. Builds, tests, live Audit, and site rendering
# belong to explicit full gates (`just verify`, `just axioms`, `just site-build`),
# not the latency-sensitive pre-commit path.
#
# Hard escape: `git commit --no-verify` bypasses ALL hooks.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# ── 1. No `admit` in staged Lean files ──────────────────────────────────
staged_lean=$(git diff --cached --name-only --diff-filter=ACM \
              | grep -E '\.lean$' || true)

if [ -n "$staged_lean" ]; then
  # Match the `admit` TACTIC (standalone, or after by / ; / => / <;>), NOT the bare
  # word in prose or comments (e.g. Audit.lean's "from a sorry/admit"). The axiom
  # audit (sorryAx) is the real backstop; this is a cheap early static check.
  bad=$(echo "$staged_lean" | xargs -r grep -lE '(^|;|=>|<;>|\bby\b)[[:space:]]*admit\b' 2>/dev/null || true)
  if [ -n "$bad" ]; then
    echo "❌ pre-commit: 'admit' tactic found in staged Lean files:"
    echo "$bad" | sed 's/^/    /'
    echo '   (replace with sorry or close the proof)'
    exit 1
  fi
fi

# ── 1b. Quality-check the exact staged Python/shell bytes ───────────────
# The formatter/linter reads files, not the Git index. Refuse partial staging for
# these paths so the checked worktree bytes are exactly the bytes being committed.
mapfile -d '' -t staged_files < <(
  git diff --cached --name-only -z --diff-filter=ACM
)
quality_files=()
partial_quality=()
for path in "${staged_files[@]}"; do
  case "$path" in
    *.py|*.sh|tools/git-hooks/*) quality_files+=("$path") ;;
    *) continue ;;
  esac
  if ! git diff --quiet -- "$path"; then
    partial_quality+=("$path")
  fi
done
if (( ${#partial_quality[@]} )); then
  echo "❌ pre-commit: Python/shell files must be staged as whole files:"
  printf '    %s\n' "${partial_quality[@]}"
  echo "   (stage the working-tree version, or restore it to the staged version)"
  exit 1
fi
if (( ${#quality_files[@]} )); then
  echo "→ pre-commit: checking staged Python/shell files"
  env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE \
    nix develop --command bash tools/autoquality.sh "${quality_files[@]}"
fi

# ── 2. No hand-rolled `axiom` outside Bang/Spec.lean family ────────────
# NOTE: post-#108 tier-folder paths (the flat Bang/X.lean paths were stale after the restructure).
staged_lean_strict=$(echo "$staged_lean" \
                     | grep -v '^Bang/Spec\.lean$' \
                     | grep -v '^Bang/Core/Typing\.lean$' \
                     | grep -v '^Bang/Meta/LR\.lean$' \
                     | grep -v '^Bang/Core/Semantics\.lean$' \
                     | grep -v '^Bang/Core/Semantics/Eval\.lean$' \
                     | grep -v '^Bang/Backend/Wasm\.lean$' \
                     | grep -v '^Bang/Audit\.lean$' || true)
if [ -n "$staged_lean_strict" ]; then
  # Require `axiom` + whitespace (a real declaration) — `axiom\b` false-matched "axiom-clean" prose.
  bad=$(echo "$staged_lean_strict" | xargs -r grep -lE '^[[:space:]]*axiom[[:space:]]' 2>/dev/null || true)
  if [ -n "$bad" ]; then
    echo "❌ pre-commit: hand-rolled axiom outside the Spec/Syntax/LR/Operational/Compile/Audit family:"
    echo "$bad" | sed 's/^/    /'
    echo "   (axioms belong only in the Phase B stub modules; concretize or move)"
    exit 1
  fi
fi

# ── 3. Statement-change detector ────────────────────────────────────────
# Theorem statements (Bang/Spec.lean PRD) are FROZEN. Modifying a statement
# (vs. filling in a proof body) is the cardinal sin in this project.
# Heuristic: ADD/REMOVE lines starting with `theorem` keyword trigger this.
# False positives possible; explicit ack via env var bypasses.
if [ -n "$staged_lean" ]; then
  theorem_changes=$(git diff --cached -- $staged_lean 2>/dev/null \
                    | grep -E '^[+-][[:space:]]*theorem' || true)
  if [ -n "$theorem_changes" ] && [ -z "${STATEMENT_CHANGE_OK:-}" ]; then
    echo "❌ pre-commit: theorem statement changes detected:"
    echo "$theorem_changes" | head -6 | sed 's/^/    /'
    echo ""
    echo "   Theorem statements are FROZEN (the PRD; per spec-proof-discipline.md)."
    echo "   To commit anyway (e.g., adding a new theorem, intentional refactor):"
    echo "     STATEMENT_CHANGE_OK=\"why this is justified\" git commit -m \"...\""
    exit 1
  fi
fi

# ── 3b. Auto-regenerate squash-stable CHANGELOG provenance ───────────────
# The changelog is a DERIVATION of git history (the GENERATE rung), not a hand-maintained copy. Rather
# than block a commit when it lags (a feat/fix commit can't include its OWN not-yet-existing entry — the
# pre-commit's `git log` doesn't see the in-flight commit), we regenerate it here from ALREADY-committed
# history and stage it. Net effect: it's always current-up-to-prior, the `--check` fitness leg below
# always passes, and the in-flight commit's own entry lands automatically in the NEXT commit. No manual
# `just changelog` dance, no blocking. (Idempotent: a no-op when nothing new to record.)
#
# NOTE: `git commit` exports GIT_INDEX_FILE (and can export GIT_DIR) into this hook's environment.
# `nix develop`/`lake`'s own git operations — e.g. inside .lake/packages/mathlib — must NOT inherit
# our index path, or they write MATHLIB's tree through OUR worktree's index (the 11-incident
# `.devcontainer/Dockerfile` ghost — plan 008). Strip only for these nix/lake invocations; the hook's
# OWN `git diff --cached` below intentionally KEEPS the env, since a pathspec commit points
# GIT_INDEX_FILE at a temporary index the hook must read to see the correct staged set.
if [ -f CHANGELOG.md ]; then
  # Never absorb unrelated CHANGELOG prose through the historical `git add` here.
  # Reject partial staging; the generated block itself is the only recursive field.
  if ! git diff --quiet -- CHANGELOG.md; then
    echo "❌ pre-commit: CHANGELOG.md cannot be partially staged."
    echo "   Stage its prose intentionally or restore the unstaged bytes."
    exit 1
  fi

  # `git commit <paths>` supplies a temporary GIT_INDEX_FILE. Capture THAT proposed
  # tree before crossing into nix, where Git env is deliberately stripped. On the
  # generated follow-up, HEAD contains the one product subject and this tree contains
  # every staged projection: precisely the virtual squash final tree.
  changelog_after_tree=$(git write-tree)
  export CHANGELOG_AFTER_TREE="$changelog_after_tree"
  env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE \
    nix develop --command just changelog > /dev/null
  git add CHANGELOG.md
  # The generated block is normalized in the identity, so staging it cannot alter
  # CHANGELOG_AFTER_TREE's change id. Re-export the final index tree for fitness.
  CHANGELOG_AFTER_TREE=$(git write-tree)
  export CHANGELOG_AFTER_TREE
fi

# ── 4. Fitness functions (fast, NO Lean build) — ALWAYS ────────────────
# check-primitives · check-adr-links · arch-check (the import-direction V, ADR-0048)
# · check-refs (stale *.md path/link references). These are cheap and need no build,
# so they gate EVERY commit — including docs-only and build-skipped — which is exactly
# when check-refs matters most (a renamed/deleted file leaving dangling doc refs).
# Only `git commit --no-verify` bypasses them.
# NOTE: don't enumerate the fitness legs here — the hand-list drifted once already;
# the composition's SSoT is generated (`just gate-index` → .claude/codebase-maintenance.md).
echo "→ pre-commit: running just fitness (full composition: just gate-index)"
if ! env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE \
  nix develop --command just fitness > /tmp/bang-fitness.log 2>&1; then
  echo "❌ pre-commit: just fitness failed. Last 20 lines:"
  tail -20 /tmp/bang-fitness.log | sed 's/^/    /'
  echo "   (full log: /tmp/bang-fitness.log) — fix the drift, or 'git commit --no-verify' to bypass."
  exit 1
fi
echo "✓ pre-commit: fitness passed"

echo "✓ pre-commit: passed (static gates only)"
